  "item": [
    {
      "name": "01 - Domínio Usuário e Autenticação",
      "item": [
        {
          "name": "Passo 01 - /auth/register",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "let timestamp = Date.now();",
                  "pm.collectionVariables.set(\"random_email\", \"carlos\" + timestamp + \"@repairshop.com\");",
                  "pm.collectionVariables.set(\"random_plate\", \"ABC\" + Math.floor(1000 + Math.random() * 9000));",
                  "function generateValidCpf() {",
                  "    const randomDigit = () => Math.floor(Math.random() * 9);",
                  "    let cpf = Array.from({length: 9}, randomDigit);",
                  "    let d1 = 0; for (let i = 0; i < 9; i++) d1 += cpf[i] * (10 - i);",
                  "    d1 = 11 - (d1 % 11); if (d1 >= 10) d1 = 0; cpf.push(d1);",
                  "    let d2 = 0; for (let i = 0; i < 10; i++) d2 += cpf[i] * (11 - i);",
                  "    d2 = 11 - (d2 % 11); if (d2 >= 10) d2 = 0; cpf.push(d2);",
                  "    return cpf.join('');",
                  "}",
                  "pm.collectionVariables.set(\"random_document\", generateValidCpf());"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{$randomFullName}}\",\n  \"function\": \"ATTENDANT\",\n  \"email\": \"{{random_email}}\",\n  \"phone\": \"11999999999\",\n  \"password\": \"securePass123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Passo 02 - /auth/login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set(\"token\", jsonData.token);",
                  "}",
                  "var reqBody = JSON.parse(pm.request.body.raw);",
                  "if (reqBody.email) {",
                  "    pm.collectionVariables.set(\"customer_email\", reqBody.email);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{random_email}}\",\n  \"password\": \"securePass123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          },
          "response": []
        }
      ]
    },
